# Copy to .env and fill in. Never commit the real .env file.

PORT=5000

# MongoDB Atlas connection string (or mongodb://localhost:27017/scan2dine locally)
MONGO_URI=

# Set to "true" to run against an in-memory database seeded with demo data
# (demo@scan2dine.com). Data is lost on every restart. Handy for a public demo.
MOCK_DB=false

# Required in production. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Allowed frontend origin(s), comma separated. Leave empty in local development.
CLIENT_URL=

NODE_ENV=development

# Optional integrations (the app runs without them)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
